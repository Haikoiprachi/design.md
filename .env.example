# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: free key from https://tavily.com for faster, more reliable search.
# Without it the agent uses keyless public search engines (via the ddgs package).
TAVILY_API_KEY=

# Optional settings
# GEMINI_MODEL=gemini-3.5-flash                                   # any Gemini model with function calling
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite,gemini-3.5-flash-lite  # used when a model is overloaded or out of daily quota
# TIMEZONE=Asia/Kolkata                 # IANA name; defaults to this computer's timezone
# GEMINI_THINKING_BUDGET=0              # optional: lower = faster on models that support a thinking budget
# MEMORY_DB=data/memory.db
# HISTORY_TURNS=12
